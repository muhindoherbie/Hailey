<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so Hailey can use a model running on your own PC (e.g. Ollama on your
     home network). Everything on the internet (AI services, Telegram, connectors) uses https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
