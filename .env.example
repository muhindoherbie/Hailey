# Hailey server configuration. Copy to .env (or run `npm run setup`) and fill in.
# .env is git-ignored. NEVER commit real keys or paste them anywhere public.

# --- Server ---
PORT=8787
# 127.0.0.1 = only this computer. Use 0.0.0.0 to allow phones on your Wi-Fi / a tunnel.
HOST=127.0.0.1
# The address you open Hailey at (used for links, cookies and the calendar feed).
PUBLIC_URL=http://localhost:8787
DATA_DIR=./data
NODE_ENV=production
# Set to false after creating your account so nobody else can sign up.
ALLOW_SIGNUP=true
MAX_USERS=5
# true only when running behind a reverse proxy / tunnel that sets X-Forwarded-For.
TRUST_PROXY=false

# --- AI provider: configure at least one ---
# Claude (paid, per token): https://console.anthropic.com -> API keys. Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is ~40x cheaper than claude-opus-5-5; you can switch in Settings at any time.
ANTHROPIC_MODEL=claude-opus-5-5

# Any OpenAI-compatible endpoint. Free and private with a local model, e.g. Ollama:
#   OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPAT_MODEL=qwen3:8b
# Hosted free tiers also work (Groq, Google Gemini's OpenAI endpoint, OpenRouter free models).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_LABEL=Local model (Ollama)
# Set to false if your model doesn't support tool/function calling.
OPENAI_COMPAT_TOOLS=true
# Optional: "none" turns off slow step-by-step thinking on local models such as qwen3 (faster replies).
OPENAI_COMPAT_REASONING_EFFORT=
# core = everyday tools only (shorter prompt, much faster on small local models); full = all 34 tools.
OPENAI_COMPAT_TOOLSET=core
# Set to true if your model can read images (e.g. gemma3, qwen2.5vl, llava). Claude always can.
OPENAI_COMPAT_VISION=false
# anthropic or openai_compat (optional; users can choose in Settings)
DEFAULT_PROVIDER=

# Safety net for AI spending: max tokens per user per 24 hours (0 = unlimited).
DAILY_TOKEN_LIMIT=400000

# --- Web research: optional, configure one ---
# Self-hosted SearXNG (free, open source): e.g. http://localhost:8888 (enable the JSON format in its settings).
SEARXNG_URL=
# Brave Search API (free tier available): https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# --- GitHub (optional, read-only) ---
# Public repositories work without a token. For private ones, create a fine-grained token with
# read-only "Contents", "Issues", "Pull requests" and "Metadata" access. Hailey never writes to GitHub.
GITHUB_TOKEN=

# --- Push notifications (generated by `npm run setup`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Windows desktop app only (optional) ---
# Open a Hailey that runs on an always-on server instead of running one on this PC.
HAILEY_REMOTE_URL=

# --- Android app (optional) ---
# Package name and signing-certificate SHA-256 of your Hailey APK, so it opens full-screen.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=

# --- Voice notes from Telegram/WhatsApp (optional) ---
# Any OpenAI-compatible speech-to-text endpoint. Free: Groq (https://api.groq.com/openai/v1 + a free
# key from console.groq.com), or a local Whisper server such as speaches (http://localhost:8000/v1).
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Place search ---
# OpenStreetMap's free Nominatim service (fair use: about 1 request per second). Self-host for heavy use.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Connected apps (MCP) ---
# Connectors on this server's own network (localhost, 192.168.x.x…) are refused unless true.
MCP_ALLOW_PRIVATE_NETWORK=false

# --- Limits ---
MAX_UPLOAD_MB=100
