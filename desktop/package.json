{
  "name": "hailey-desktop",
  "productName": "Hailey",
  "version": "3.2.0",
  "description": "Hailey \u2014 personal AI assistant for Windows",
  "author": "muhindoherbie",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.hailey.desktop",
    "productName": "Hailey",
    "copyright": "Copyright \u00a9 2026 muhindoherbie",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "hailey"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "Hailey-Setup-${version}.exe",
      "signtoolOptions": {
        "publisherName": [
          "Hailey (muhindoherbie)"
        ],
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hailey",
      "deleteAppDataOnUninstall": false
    }
  }
}
